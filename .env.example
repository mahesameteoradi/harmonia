# Salin jadi .env.local untuk dev lokal.
# Di production, isi di Vercel Settings -> Environment Variables (scope: Build + Runtime).
#
# Hanya dua nilai. Keduanya memang dirancang publik dan boleh muncul di frontend —
# yang melindungi data adalah Row Level Security, bukan kerahasiaan key ini.
#
# Aplikasi ini tidak punya secret apa pun: tidak ada service_role key,
# tidak ada client secret, tidak ada token pihak ketiga.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
